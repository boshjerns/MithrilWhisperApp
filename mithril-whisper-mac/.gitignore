# 🚨 MITHRIL WHISPER - Security-First .gitignore

# ==============================================================================
# 🔥 CRITICAL - Sensitive Configuration Files (NEVER COMMIT)
# ==============================================================================
# Note: webpack configs and package.json should be tracked in git
# Only sensitive files like .env should be ignored

# Environment variables
.env*
!env.example

# ==============================================================================
# 🔐 Secrets & Credentials
# ==============================================================================
**/config/secrets.js
**/config/keys.js
**/*secrets*
**/*keys*
**/*token*
**/*api-key*

# Code signing & certificates  
*.p12
*.cer
*.mobileprovision
*.provisionprofile
**/signing/*
**/certificates/*
**/certs/*
*.keychain
*.keychain-db

# ==============================================================================
# 📦 Build & Distribution
# ==============================================================================
dist/
build/main/
build/renderer/
*.dmg
*.exe
*.msi
*.deb
*.rpm
*.AppImage
temp/
tmp/
.tmp/

# ==============================================================================
# 🎯 Audio & Media Files (Privacy)
# ==============================================================================
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.flac
*.wma
models/*.bin
whisper-cpp/models/*.bin

# ==============================================================================
# 📱 Standard Node.js
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.backup

# ==============================================================================
# 🖥️ IDE & System Files
# ==============================================================================
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================================================
# 📊 Logs & Development
# ==============================================================================
logs/
*.log
crash-reports/
.nyc_output/
.cache/
.parcel-cache/
coverage/
*.tsbuildinfo

# ==============================================================================
# 🚨 Personal Information Patterns
# ==============================================================================
*personal*
*private*
*confidential*
# =================================================================
# 🚫 LARGE FILES - Prevent accidental commits (50MB+ files)
# =================================================================
# Model files (users download these separately or via build process)
*.bin
models/
whisper-cpp/*.bin

# Installation artifacts and built apps
clean-install*/
test-install*/
expanded-working/
extracted-pkg/
*.app/

# Large binaries and payloads
Payload
*/Payload
Electron Framework
*/Electron Framework

# Installation test folders (not needed in Git)
clean-install*/
test-install*/
expanded-working/
extracted-pkg/

# macOS system files
.DS_Store
**/.DS_Store

# BFG cleanup reports
..bfg-report/
**/..bfg-report/
